# RevTaw environment variables
# Copy this file to .env.local (ignored by git) and fill in your own values.
# Never commit real keys. Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Supabase (Project Settings → API) ---------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
# Safe for the browser: all data access is still protected by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
# Used for privileged operations such as deleting a user's own account.
# Leave empty to disable those features. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Public origin of this deployment, used in email links (verification, reset).
# Leave empty for http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# --- AI (server only — never prefix these with NEXT_PUBLIC_) ------------------
# Which provider to use: anthropic | openai | google | mock.
# Leave empty to auto-detect from whichever key below is set
# (mock is used automatically in development when no key is set).
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Optional model overrides for the two tiers RevTaw uses.
# Defaults: anthropic claude-haiku-4-5 / claude-sonnet-4-5,
#           openai gpt-4.1-mini / gpt-4.1, google gemini-2.5-flash / gemini-2.5-pro
AI_MODEL_FAST=
AI_MODEL_STRONG=

# --- Email reminders (server only — optional) ---------------------------------
# Leave EMAIL_PROVIDER empty to keep reminders in-app only. Never commit real
# credentials: set these in .env.local or in your host's environment settings.
# EMAIL_PROVIDER: resend | smtp
EMAIL_PROVIDER=
# Sender shown to students, e.g. "RevTaw <reminders@yourdomain.com>"
EMAIL_FROM=
# resend: an API key from resend.com
RESEND_API_KEY=
# smtp: for a RevTaw Gmail account use smtp.gmail.com, port 465 and an app
# password (Google Account → Security → App passwords), not the real password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
