# RevTaw environment variables
# Copy this file to .env.local (ignored by git) and fill in your own values.
# Never commit real keys. Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Supabase (Project Settings → API) ---------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
# Safe for the browser: all data access is still protected by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
# Used for privileged operations: deleting a student's own account, the
# scheduler, recording AI token counts and voice seconds (the daily AI limits
# still apply without it, but voice minutes are not counted), giving back AI
# requests that failed, Google Calendar, and the key behind analytics
# pseudonyms. Leave empty to disable those. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Public origin of this deployment, e.g. https://revtaw.example.com: used in
# sign-up and password emails, reminder and digest emails (with their
# unsubscribe links) and Google Calendar events. Leave empty for
# http://localhost:3000 in development; on Vercel the production domain is
# used. In production without it, reminder emails, the digest and calendar
# events go out without links.
NEXT_PUBLIC_SITE_URL=

# --- AI (server only — never prefix these with NEXT_PUBLIC_) ------------------
# RevTaw routes every AI request through the providers you configure, in this
# order: Groq → Cloudflare Workers AI → Anthropic → OpenAI → Ollama. A provider
# is skipped when a request is too big for it, when it cannot read images, or
# for a few minutes after it answers "busy" (429) or fails. Set at least Groq
# and Cloudflare; both have free tiers and do not train on your data.
# With no key at all, development uses a built-in mock provider.
#
# Groq (https://console.groq.com/keys) — first choice for chat and short tasks.
GROQ_API_KEY=
# Cloudflare Workers AI (dash.cloudflare.com → AI → Workers AI → Use REST API):
# the 32-character Account ID and an API token with "Workers AI" read/edit
# permission. Takes long generations, image reading and embeddings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Paid providers, used after the free ones (optional).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama on your own computer for offline development (optional), e.g.
# http://localhost:11434/v1 after `ollama pull qwen3.5:4b` and `qwen3.5:9b`.
OLLAMA_BASE_URL=
#
# Optional tuning — the defaults are usually right:
# AI_PROVIDER: leave empty (or "auto") to route as above, or name one
#   provider (groq | cloudflare | ollama | anthropic | openai | google | mock)
#   to send every request to it; AI_MODEL_FAST / AI_MODEL_STRONG then pick its
#   models. Google (Gemini, GOOGLE_AI_API_KEY) is never chosen automatically:
#   its terms bar apps likely used by people under 18. It is used only when
#   named here or in AI_PROVIDER_ORDER.
AI_PROVIDER=
# AI_PROVIDER_ORDER=groq,cloudflare,anthropic,openai,ollama
# AI_MODEL_FAST=
# AI_MODEL_STRONG=
# Each student's daily AI allowance (counted per Philippine day; needs
# migrations 0016 and 0021). Requests per kind default to
# chat=60,generate=10,study=60,upload=30,voice=60; voice also stops at
# voice_seconds (seconds of voice typing, default 1800) and voice_chars
# (characters read aloud in Filipino, default 20000). Set "off" to turn the
# allowance off.
# AI_DAILY_LIMITS=chat=60,generate=10,study=60,upload=30,voice=60,voice_seconds=1800,voice_chars=20000
# Model overrides per provider (defaults shown):
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Largest request sent to Groq, in tokens (input + output). Its free plan
# allows 8,000 tokens a minute per model; raise this on a paid plan.
# GROQ_MAX_REQUEST_TOKENS=7500
# CLOUDFLARE_MODEL_FAST=@cf/openai/gpt-oss-20b
# CLOUDFLARE_MODEL_STRONG=@cf/openai/gpt-oss-120b
# Reads uploaded photos and images; "off" turns image reading off.
# CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# OLLAMA_MODEL_FAST=qwen3.5:4b
# OLLAMA_MODEL_STRONG=qwen3.5:9b
# Ollama's context size (num_ctx in your Modelfile); longer requests skip it.
# OLLAMA_CONTEXT_TOKENS=8192
# Route through a gateway such as Cloudflare AI Gateway instead (optional;
# https only, since the key travels with every request):
# GROQ_BASE_URL=
# CLOUDFLARE_AI_BASE_URL=
#
# Check the setup: while signed in to `npm run dev`, open
# /api/system/services?live=1 (elsewhere, send Authorization: Bearer <CRON_SECRET>).

# --- Voice fallbacks (server only — optional) ----------------------------------
# Tamari uses the browser's own speech recognition and voices first. Where
# the browser has no speech recognition (Firefox, iPhone home-screen apps),
# a short recording goes to Groq's Whisper, then Cloudflare's, using the keys
# above. Where the device has no Filipino voice, Filipino answers are read by
# Azure AI Speech's fil-PH neural voice: create a Speech resource (free F0
# tier: 0.5 million characters a month) in Azure portal → Speech service, and
# copy Keys and Endpoint → KEY 1 and the region (e.g. southeastasia).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# fil-PH-BlessicaNeural (default) or fil-PH-AngeloNeural.
# AZURE_TTS_VOICE=fil-PH-BlessicaNeural

# --- Email: reminders and the daily digest (server only — optional) ---------
# RevTaw sends email through Resend only, from a domain you own (verify it in
# Resend with SPF and DKIM, and add a DMARC record). Never use a personal Gmail
# password or app password. Leave these empty to keep reminders in-app only.
# Every email has a one-click unsubscribe link and is never sent twice.
# Resend's free plan allows 100 emails a day (shared with Supabase Auth's
# emails if you use Resend for those too): enough for one digest per student.
RESEND_API_KEY=
# Sender on your verified domain, e.g. "RevTaw <reminders@mail.yourdomain.com>"
EMAIL_FROM=

# --- Google Calendar (server only — optional) ---------------------------------
# Lets students copy their plan and exams to a "RevTaw Study" calendar. Create
# an OAuth client in Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID → Web application), enable the Google Calendar API, and add
# this authorized redirect URI:  <your site>/api/calendar/google/callback
# RevTaw asks only for .../auth/calendar.app.created (its own calendar). Until
# Google verifies the app, at most 100 test users can connect and their
# access expires after 7 days. Never ask for or store Google passwords.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts Google refresh tokens in the database: 32 random bytes in base64
# (`openssl rand -base64 32`). Changing it disconnects everyone's calendar.
CALENDAR_TOKEN_KEY=

# --- Usage analytics (server only — optional) ---------------------------------
# PostHog Cloud EU, only for students who turn on Settings → Account → Usage
# analytics (off by default). Events name the feature used (a quiz was made,
# Tamari answered) and never carry content; the student is a hash keyed with
# SUPABASE_SECRET_KEY (or CRON_SECRET), and analytics stays off without one.
# Use the project API key from PostHog → Project settings.
POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Scheduler (server only — optional) ---------------------------------------
# Delivers planner reminders while students are away, sends reminder email and
# the daily digest, and fills in search embeddings. Set a long random value
# (16+ characters, e.g. `openssl rand -hex 32`) and have a scheduler call, with
# the header  Authorization: Bearer <CRON_SECRET>:
#   /api/cron/reminders   every minute (or every 5)
#   /api/cron/digest      every 15 minutes (each student gets it once, 6–11 a.m.)
#   /api/cron/embeddings  every 10 minutes (only works while chunks are waiting)
#   /api/cron/calendar    every hour (Google Calendar; changes also sync at once)
# supabase/schedules.sql sets these up with Supabase's pg_cron. Vercel Cron
# also sends the header when CRON_SECRET is set (Pro plan for frequent runs).
# Also needs SUPABASE_SECRET_KEY above. Without it, reminders still reach the
# in-app bell (and the browser) while RevTaw is open, and on the next visit.
CRON_SECRET=
